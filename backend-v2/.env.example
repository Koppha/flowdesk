NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/advance_request
JWT_SECRET=change_me_to_a_long_secret
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
# Public hostname for one-click email approve/reject links, fronted by the
# restricted proxy location in deploy/nginx-email-action-proxy.conf.example
# (forwards ONLY to this backend's /email-actions route - the backend
# renders a self-contained HTML confirmation page, no frontend involved).
# Leave unset to fall back to APP_URL (internal-only SPA flow; email links
# won't be reachable from outside the network).
# EMAIL_ACTION_PUBLIC_URL=https://your-internal-proxy.example.com/flowdesk/uat
AD_AUTH_ENABLED=false
AD_AUTH_URL=https://your-internal-proxy.example.com/ldap/api/autheticate_User
AD_API_BASE_URL=https://your-internal-proxy.example.com/ldap/api
AD_AUTH_PATH=/autheticate_User
AD_TIMEOUT_MS=12000
AD_FALLBACK_LOCAL=true
AD_SYNTHETIC_EMAIL_DOMAIN=etl.co.ls

# ── Email (Active Directory HTTP API — primary transport) ──
EMAIL_API_ENABLED=true
EMAIL_API_BASE_URL=https://your-internal-email-api.example.com/EmailActiveDirectoryAPI
EMAIL_API_TIMEOUT_MS=15000

# ── Microsoft Teams Incoming Webhook ──
# Set TEAMS_ENABLED=true and paste your channel webhook URL below.
# In Teams: channel ▸ ··· ▸ Connectors ▸ Incoming Webhook ▸ Create ▸ copy URL
TEAMS_ENABLED=false
TEAMS_WEBHOOK_URL=
