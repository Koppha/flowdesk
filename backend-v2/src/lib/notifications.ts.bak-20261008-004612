        ]
      }).catch((e) => logger.warn("teams_delegation_ended_failed", { error: serializeError(e) }));
    } catch (error) {
      logger.warn("delegation_ended_delegate_notification_failed", {
        delegation_id: args.delegationId, error: serializeError(error)
