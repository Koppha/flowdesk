# Example nginx vhost for a PROD advance-clearance server. TREAT AS A
# STARTING POINT, NOT GROUND TRUTH: as of 2026-08-18, PROD1 and PROD2 had
# each drifted from this file and from each other (different listen ports,
# PROD1 running an extra proxy layer because it's a Kubernetes/RKE2 node -
# see deploy/README.md step 7 for the full, current, per-node picture and
# deploy/k8s-ingress-prod1.yaml.example for what PROD1 additionally needs).
# Confirm `nginx -T` on the actual box before trusting this file matches it.
#
# Copy to /etc/nginx/sites-available/, adjust server_name/ports, then symlink
# into sites-enabled and reload nginx.
#
# There is no separate load balancer - flowdesk.etl.co.ls DNS round-robins
# directly to each PROD node's own IP, and each node terminates its own TLS
# with the same real cert (/etc/nginx/ssl/flowdesk.{crt,key}). `serve`
# itself binds all interfaces (deploy/ecosystem.config.cjs - loopback-only
# crashes the installed `serve` version), so its port must be firewalled
# from outside each PROD node for nginx to be the only public entry point.

server {
    listen 80;
    server_name _;

    # Frontend (served by `serve -s dist -l 5174` via PM2)
    location / {
        proxy_pass http://127.0.0.1:5174;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Backend API (PORT from /etc/advance-clearance/.env, default 4000)
    location /api/ {
        proxy_pass http://127.0.0.1:4000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
